  { "name": "S7 (Б5 ч.2): удаление группы ЦИКЛОМ removeEntity вместо одного фильтра — N шагов истории", "file": "js/app.js",
    "from": "state.posts=state.posts.filter(p=>!kill.has(String(p.id)));", "to": "kill.forEach(id=>removeEntity(\"post\",id));" },

